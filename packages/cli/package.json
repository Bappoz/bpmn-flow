{
  "name": "@bpmn-flow/cli",
  "version": "0.2.0",
  "description": "Command line for BPMN Flow: validate, inspect and run BPMN 2.0 processes from the terminal.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "bpmn",
    "bpmn2",
    "workflow",
    "workflow-engine",
    "process-automation",
    "typescript",
    "cli",
    "command-line"
  ],
  "homepage": "https://github.com/Bappoz/bpmn-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bappoz/bpmn-flow.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Bappoz/bpmn-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "bpmn-flow": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bpmn-flow/core": "^0.2.0"
  }
}
