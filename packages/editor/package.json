{
  "name": "@bpmn-flow/editor",
  "version": "0.1.0",
  "description": "Browser BPMN 2.0 modeler with layout support and structural validation.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "bpmn",
    "bpmn2",
    "workflow",
    "typescript",
    "bpmn-js",
    "editor",
    "modeler",
    "browser"
  ],
  "homepage": "https://github.com/Bappoz/bpmn-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bappoz/bpmn-flow.git",
    "directory": "packages/editor"
  },
  "bugs": {
    "url": "https://github.com/Bappoz/bpmn-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bpmn-flow/core": "^0.1.0",
    "@bpmn-flow/viewer": "^0.1.0",
    "bpmn-js": "^18.28.0"
  }
}
