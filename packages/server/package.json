{
  "name": "@bpmn-flow/server",
  "version": "0.2.0",
  "description": "Embeddable HTTP server exposing @bpmn-flow/core execution over a REST API and serving an interactive BPMN viewer on a port.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "bpmn",
    "bpmn2",
    "workflow",
    "workflow-engine",
    "process-automation",
    "typescript",
    "rest-api",
    "hono",
    "server"
  ],
  "homepage": "https://github.com/Bappoz/bpmn-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bappoz/bpmn-flow.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/Bappoz/bpmn-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "bpmn-flow-serve": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/bin.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bpmn-flow/core": "^0.2.0",
    "@hono/node-server": "^2.0.8",
    "hono": "^4.13.8"
  }
}
