{
  "name": "@bpmn-flow/viewer",
  "version": "0.2.0",
  "description": "Interactive BPMN viewer that overlays live @bpmn-flow/core execution state on a bpmn-visualization diagram.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "bpmn",
    "bpmn2",
    "workflow",
    "workflow-engine",
    "process-automation",
    "typescript",
    "bpmn-visualization",
    "diagram",
    "browser",
    "visualization"
  ],
  "homepage": "https://github.com/Bappoz/bpmn-flow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bappoz/bpmn-flow.git",
    "directory": "packages/viewer"
  },
  "bugs": {
    "url": "https://github.com/Bappoz/bpmn-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bpmn-flow/core": "^0.2.0",
    "bpmn-auto-layout": "^1.3.0",
    "bpmn-visualization": "^0.48.0"
  }
}
